# Google Calendar OAuth credentials
# Create these at https://console.cloud.google.com/apis/credentials
OAUTH_CLIENTID="your-google-oauth-client-id"
OAUTH_SECRET="your-google-oauth-client-secret"
REFRESH_TOKEN="your-google-oauth-refresh-token"
CALENDAR_ID="calender-id"

# Notion API credentials
# Get these from https://www.notion.so/my-integrations
NOTION_KEY="your-notion-integration-secret"
DATABASE_ID="your-notion-database-id"

# Time Zone (used in Google Calendar)
TZ="Canada/Eastern"
